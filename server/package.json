{
  "name": "moi-dity-server",
  "version": "0.1.0",
  "private": true,
  "description": "Сервер «Мої діти»: геолокація дітей, геозони, SOS і повітряні тривоги",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check-firebase": "node --env-file-if-exists=.env src/check-firebase.js"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "firebase-admin": "^13.10.0",
    "pg": "^8.23.1"
  }
}
