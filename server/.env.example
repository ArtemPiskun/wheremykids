PORT=8080
DATABASE_URL=postgres://moi:moi@localhost:5432/moi
# Токен alerts.in.ua, видають за заявкою: https://alerts.in.ua/api-request
ALERTS_IN_UA_TOKEN=
ALERTS_POLL_MS=15000
# Поки немає токена — заглушка: тривоги вмикаються вручну на http://localhost:8080/dev/alerts?token=<DEV_TOKEN>
# (mock — заглушка, live — alerts.in.ua; без токена за замовчуванням mock)
ALERTS_MODE=mock
DEV_TOKEN=change-me
# Межі областей (GeoJSON, напр. geoBoundaries UKR ADM1). Без файлу область визначає Nominatim (OSM)
OBLAST_GEOJSON_PATH=
# USE_NOMINATIM=0 — вимкнути Nominatim
# Ключ сервісного акаунта Firebase (проєкт my-kids-1f72d). Файл не комітити!
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Або весь ключ одним рядком base64 (для хостингів без файлів):
# FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=my-kids-1f72d
LOCATION_RETENTION_DAYS=30
