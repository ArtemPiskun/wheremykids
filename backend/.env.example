# Copy to .env and fill in. Generate secrets with: npm run gen:secrets
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Number of trusted reverse-proxy hops in front of the API (for correct client IPs in rate limiting).
TRUST_PROXY=0
# all = API + push worker + nightly jobs; split into api/worker pods in production.
RUN_MODE=all

DATABASE_URL=postgres://demoidity:demoidity@localhost:5432/demoidity
DATABASE_POOL_MAX=20
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS_PARENT=60
REFRESH_TTL_DAYS_CHILD=180

INVITE_PEPPER=
AUDIT_IP_SALT=

# version:base64(32 bytes); keep old versions listed after rotation so history stays readable.
LOCATION_ENC_KEYS=
LOCATION_ENC_ACTIVE_KEY=1

# log = print pushes to the console; fcm = send through Firebase Cloud Messaging.
PUSH_DRIVER=log
FCM_SERVICE_ACCOUNT_B64=

CORS_ORIGINS=
